# Copy to .env and fill in. Only ANTHROPIC_API_KEY is required.
# Without a key the app still runs: calibration falls back to the local
# detector, low-confidence OCR is not re-read, and captions use a template.

ANTHROPIC_API_KEY=

# Only if your key is not scoped to a workspace (the API says so in its error):
# the workspace ID from Claude Console > Settings > Workspaces, e.g. wrkspc_01...
ANTHROPIC_WORKSPACE_ID=

# Claude model for calibration, OCR fallback and captions.
CLAUDE_MODEL=claude-sonnet-5-5

# Hard cap on Claude spend per job (USD).
CLAUDE_BUDGET_PER_JOB_USD=2

# Score bug samples per second of video.
OCR_SAMPLE_FPS=2

# Folders the file picker may browse, separated by ; (Windows) or : (Mac/Linux).
# Empty = your home folder.
ALLOWED_ROOTS=

# Folders (relative paths resolve against the repo root).
INBOX_DIR=inbox
DATA_DIR=data
EXPORTS_DIR=exports

# Optional overrides.
# API_PORT=8000
# FFMPEG_PATH=
# FFPROBE_PATH=
# ANALYSIS_WORKERS=        # parallel decode workers, default = min(6, cpu_count/2)
# HWACCEL=none             # none | auto (hardware decode for the sampling stage)
